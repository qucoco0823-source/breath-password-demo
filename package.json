    "test:roundtrip": "node --test test/roundtrip.test.mjs",
    "fixture:field": "node tests/make-field-fixture.mjs",
    "fixture:health": "node tests/make-health-fixture.mjs",
    "data:careup": "node tools/convert-careup.mjs",
    "analyze:health": "node experiments/analyze-health.js",
    "exp:percapita": "node experiments/percapita.js",
    "exp:decompose": "node experiments/decompose.js",
    "analyze": "node experiments/analyze-field.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "vite": "^7.1.2"
  }
