{
  "name": "breath-password-merged",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "呼吸即密码 · 三方整合（人1采集 + 人2匹配 + 人3界面）。行为密码，非生物识别。",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
